X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/seaweed-foraging-on-the-sonoma-coast/18442134/2026-04-19T06", "Press Democrat": "https://www.foragesf.com/seaweed-foraging-sonoma"}
