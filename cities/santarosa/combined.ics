X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/wise-girl-workshops-school-year-wellness-workshops/17774459/2026-04-16T16", "Press Democrat": "https://wisegirlworkshops.com/workshops-and-services/school-year-wellness-workshop-series/"}
