X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/become-a-volunteer-seabird-monitor/17319237/2026-03-09T18", "Press Democrat": "https://stewardscr.org/events/2026-seabird-monitoring-volunteer-training/"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/become-a-volunteer-seabird-monitor/17319237/2026-03-09T18"}
