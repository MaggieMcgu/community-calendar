X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/encaustic-mixed-media-open-studio/18120582/2026-04-23T18", "Press Democrat": "https://artescapesonoma.jumbula.com/Spring2026/EncausticMixedMediaOpenStudioApril"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/encaustic-mixed-media-open-studio/18120582/2026-04-23T18"}
