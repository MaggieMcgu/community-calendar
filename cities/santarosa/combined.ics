BEGIN:VEVENT
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.duttonestate.com/visit-us/tasting-reservations/", "Press Democrat": "https://www.duttonestate.com/visit-us/tasting-reservations/"}
