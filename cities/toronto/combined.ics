 urant+near+yonge+and+davisville+toronto&rlz=1C1RXMK_enCA1182CA1182&ie=UTF-
 8&lqi=CjZjYXJpYmJlYW4gcmVzdGF1cmFudCBuZWFyIHlvbmdlIGFuZCBkYXZpc3ZpbGxlIHRv
 cm9udG9Ioer0hYO9gIAIWkgQABABGAAYAxgGIjZjYXJpYmJlYW4gcmVzdGF1cmFudCBuZWFyIH
 lvbmdlIGFuZCBkYXZpc3ZpbGxlIHRvcm9udG8qBAgDEAGSARRjYXJpYmJlYW5fcmVzdGF1cmFu
